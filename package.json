{
  "name": "byusi-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"python server/app.py\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "python server/app.py",
    "start": "npm run build && mkdir -p dist/server && cp server/*.py dist/server/ && cp server/.env dist/server/ 2>/dev/null || true && python dist/server/app.py"
  },
  "dependencies": {
    "@types/highlight.js": "^9.12.4",
    "concurrently": "^8.2.2",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "less": "^4.6.7",
    "typescript": "^5.3.0",
    "vite": "^6.0.0"
  }
}